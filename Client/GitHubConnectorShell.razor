@namespace StudioElf.Module.CRM.GitHubConnector
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using StudioElf.Module.GitHubConnector.Client
@using StudioElf.Module.GitHubConnector.Models
@using StudioElf.Module.GitHubConnector.Services
@inherits GitHubConnectorBase
@inject IGitHubRepositoryService RepositoryService
@inject IGitHubReleaseService ReleaseService
@inject IGitHubSyncService SyncService
@inject IGitHubWebhookService WebhookService

<div class="crm-shell">
    <div class="gh-shell-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3><i class="bi bi-github me-2"></i>GitHub Connector</h3>
                <p class="text-muted">Repository synchronization, releases, and webhook events.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SyncAllAsync" disabled="@IsSyncing">
                    <i class="bi bi-arrow-repeat me-1"></i>@(IsSyncing ? "Syncing..." : "Sync All")
                </button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => ShowAddForm = true" disabled="@ShowAddForm">
                    <i class="bi bi-plus-circle me-1"></i>Add Repository
                </button>
            </div>
        </div>
        <div class="gh-stats-bar">
            <div class="gh-stat">
                <span class="gh-stat-value">@Repositories.Count</span>
                <span>Tracked Repos</span>
            </div>
            <div class="gh-stat">
                <span class="gh-stat-value">@TotalStars</span>
                <span>Stars</span>
            </div>
            <div class="gh-stat">
                <span class="gh-stat-value">@TotalOpenIssues</span>
                <span>Open Issues</span>
            </div>
        </div>
    </div>

    @if (ShowAddForm)
    {
        <div class="gh-add-form">
            <input @bind="NewRepoFullName" class="form-control form-control-sm"
                   placeholder="owner/repo (e.g. dotnet/aspnetcore)"
                   @onkeydown="HandleAddKeyDown" />
            <button type="button" class="btn btn-success btn-sm" @onclick="AddRepositoryAsync" disabled="@IsAdding">
                @(IsAdding ? "Adding..." : "Add")
            </button>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowAddForm = false">Cancel</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-@(StatusIsError ? "danger" : "success") alert-dismissible fade show" role="alert">
            @StatusMessage
            <button type="button" class="btn-close" @onclick="() => StatusMessage = null"></button>
        </div>
    }

    @if (SyncResult != null)
    {
        <div class="alert alert-@(SyncResult.Success ? "success" : "warning") alert-dismissible fade show" role="alert">
            @SyncResult.Message
            @if (SyncResult.Errors.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var err in SyncResult.Errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
            <button type="button" class="btn-close" @onclick="() => SyncResult = null"></button>
        </div>
    }

    <div class="gh-tab-bar">
        <button type="button" class="gh-tab-btn @(ActiveTab == "repos" ? "gh-tab-active" : "")" @onclick="SwitchToRepos">
            <i class="bi bi-journal-code me-1"></i>Repositories
        </button>
        <button type="button" class="gh-tab-btn @(ActiveTab == "webhooks" ? "gh-tab-active" : "")" @onclick="SwitchToWebhooks">
            <i class="bi bi-broadcast me-1"></i>Webhook Events
        </button>
    </div>

    <div class="crm-tabpanel">
        @if (ActiveTab == "webhooks")
        {
            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadWebhookEventsAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
            </div>

            @if (_webhookEvents.Count == 0)
            {
                <p class="text-muted mb-0 small">No webhook events received yet. Configure webhooks in your GitHub repository settings.</p>
            }
            else
            {
                @foreach (var evt in _webhookEvents)
                {
                    <div class="gh-webhook-row">
                        <span class="gh-webhook-event">@evt.EventType</span>
                        <span class="gh-webhook-repo">@evt.RepositoryFullName</span>
                        <span>
                            @switch (evt.Status)
                            {
                                case "new": <span class="badge bg-primary">New</span>; break;
                                case "processed": <span class="badge bg-success">Processed</span>; break;
                                case "ignored": <span class="badge bg-secondary">Ignored</span>; break;
                                case "failed": <span class="badge bg-danger">Failed</span>; break;
                                default: <span class="badge bg-secondary">@evt.Status</span>; break;
                            }
                        </span>
                        <span class="gh-repo-meta">@FormatLocalDate(evt.ReceivedOn, "g")</span>
                    </div>
                }
            }
        }
        else
        {
            @if (Repositories.Count == 0)
            {
                <p class="text-muted mb-0">No repositories tracked yet. Click "+ Add Repository" to begin.</p>
            }
            else
            {
                @foreach (var repo in Repositories)
                {
                    <div class="gh-repo-row" @onclick="() => LoadReleasesAsync(repo.Id)">
                        <div class="gh-repo-main">
                            <span class="gh-repo-name">@repo.FullName</span>
                            <span class="gh-repo-meta">@repo.Description</span>
                        </div>
                        <div class="gh-repo-stats">
                            <span class="gh-repo-badge" title="Stars">⭐ @repo.Stars</span>
                            <span class="gh-repo-badge" title="Forks">@repo.Forks</span>
                            <span class="gh-repo-badge d-none d-md-inline-flex" title="Language">@repo.PrimaryLanguage</span>
                            <span class="gh-repo-meta d-none d-lg-block" title="Last synced">@FormatLocalDate(repo.LastSyncedOn, "g")</span>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteRepositoryAsync(repo.Id)">
                                <i class="bi bi-trash me-1"></i>Remove
                            </button>
                        </div>

                        @if (SelectedRepoId == repo.Id)
                        {
                            <div class="gh-releases">
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => SelectedRepoId = null">
                                    Hide Releases
                                </button>
                                @if (Releases.Count > 0)
                                {
                                    @foreach (var release in Releases)
                                    {
                                        <div class="gh-release-row">
                                            <span class="gh-release-tag">@release.TagName</span>
                                            <span class="gh-release-name">@release.ReleaseName</span>
                                            <span class="gh-repo-meta">@FormatLocalDate(release.PublishedAt, "g")</span>
                                            <span>@(release.IsPrerelease ? "⚠️" : "")</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mt-1 mb-0">No releases found.</p>
                                }
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private string ActiveTab { get; set; } = "repos";

    private GitHubSettings Settings { get; set; } = new();
    private List<GitHubRepositoryDto> Repositories { get; set; } = new();
    private List<GitHubReleaseDto> Releases { get; set; } = new();

    private string? NewRepoFullName;
    private bool ShowAddForm;
    private bool IsSyncing;
    private bool IsAdding;
    private string? StatusMessage;
    private bool StatusIsError;
    private SyncResultDto? SyncResult;
    private int? SelectedRepoId;
    private List<WebhookEventDto> _webhookEvents = new();

    private int TotalStars => Repositories.Sum(r => r.Stars);
    private int TotalOpenIssues => Repositories.Sum(r => r.OpenIssues);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await LoadRepositoriesAsync();
        await LoadWebhookEventsAsync();
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
    }

    private void SwitchToRepos() => SwitchTab("repos");
    private void SwitchToWebhooks() => SwitchTab("webhooks");

    private async Task LoadSettingsAsync()
    {
        try
        {
            Dictionary<string, string> SiteSettings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            if (SiteSettings.TryGetValue(GitHubSettings.SettingsKey, out var jsonSettings))
            {
                Settings = JsonSerializer.Deserialize<GitHubSettings>(jsonSettings) ?? new GitHubSettings();
            }
            else
            {
                Settings = new GitHubSettings();
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to load settings: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        try
        {
            Repositories = await RepositoryService.GetAllAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to load repositories: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task LoadWebhookEventsAsync()
    {
        try
        {
            _webhookEvents = await WebhookService.GetRecentEventsAsync(ModuleState.ModuleId, 20);
        }
        catch
        {
            _webhookEvents = new();
        }
    }

    private async Task AddRepositoryAsync()
    {
        if (string.IsNullOrWhiteSpace(NewRepoFullName))
            return;

        IsAdding = true;
        StatusMessage = null;

        try
        {
            var dto = new AddRepositoryDto { FullName = NewRepoFullName.Trim() };
            var createdBy = PageState?.User?.Username ?? "system";
            await RepositoryService.AddRepositoryAsync(dto, ModuleState.ModuleId, createdBy);
            NewRepoFullName = null;
            ShowAddForm = false;
            await LoadRepositoriesAsync();
            StatusMessage = "Repository added.";
            StatusIsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to add repository: {ex.Message}";
            StatusIsError = true;
        }
        finally
        {
            IsAdding = false;
        }
    }

    private async Task DeleteRepositoryAsync(int repositoryId)
    {
        try
        {
            await RepositoryService.DeleteAsync(repositoryId, ModuleState.ModuleId);
            if (SelectedRepoId == repositoryId)
                SelectedRepoId = null;
            await LoadRepositoriesAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to remove repository: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task SyncAllAsync()
    {
        IsSyncing = true;
        SyncResult = null;

        try
        {
            SyncResult = await SyncService.SyncAllAsync(ModuleState.ModuleId, Settings.PersonalAccessToken);
            await LoadRepositoriesAsync();
        }
        catch (Exception ex)
        {
            SyncResult = new SyncResultDto
            {
                Success = false,
                Message = $"Sync failed: {ex.Message}",
                Errors = { ex.ToString() }
            };
        }
        finally
        {
            IsSyncing = false;
        }
    }

    private async Task LoadReleasesAsync(int repositoryId)
    {
        try
        {
            SelectedRepoId = repositoryId;
            Releases = await ReleaseService.GetByRepositoryAsync(repositoryId, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to load releases: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task HandleAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddRepositoryAsync();
        }
    }
}
