@namespace StudioElf.Module.CRM.GitHubConnector
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using StudioElf.Module.GitHubConnector.Client
@using StudioElf.Module.GitHubConnector.Models
@using StudioElf.Module.GitHubConnector.Services
@inherits GitHubConnectorBase
@inject IGitHubRepositoryService RepositoryService
@inject IGitHubReleaseService ReleaseService
@inject IGitHubSyncService SyncService
@inject IGitHubWebhookService WebhookService

<div class="crm-shell">
    <h3>CRM GitHub Enterprise Connector</h3>
    <p class="text-muted">
        Manage GitHub repository synchronization and linking.
        Settings are available in the gear icon (Host) and Settings tab (Users).
    </p>

    <hr />

    <!-- Repository List -->
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Tracked Repositories</h5>
            <div>
                <button class="btn btn-outline-primary btn-sm me-1" @onclick="SyncAllAsync" disabled="@IsSyncing">
                    @(IsSyncing ? "Syncing..." : "Sync All")
                </button>
                <button class="btn btn-primary btn-sm" @onclick="() => ShowAddForm = true"
                        disabled="@ShowAddForm">
                    + Add Repository
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (ShowAddForm)
            {
                <div class="input-group mb-3">
                    <input @bind="NewRepoFullName" class="form-control"
                           placeholder="owner/repo (e.g. dotnet/aspnetcore)"
                           @onkeydown="HandleAddKeyDown" />
                    <button class="btn btn-success" @onclick="AddRepositoryAsync" disabled="@IsAdding">
                        @(IsAdding ? "Adding..." : "Add")
                    </button>
                    <button class="btn btn-secondary" @onclick="() => ShowAddForm = false">Cancel</button>
                </div>
            }

            @if (Repositories.Count == 0)
            {
                <p class="text-muted mb-0">No repositories tracked yet. Click "+ Add Repository" to begin.</p>
            }
            else
            {
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Repository</th>
                            <th>Stars</th>
                            <th>Forks</th>
                            <th>Language</th>
                            <th>Last Synced</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repo in Repositories)
                        {
                            <tr @onclick="() => LoadReleasesAsync(repo.Id)" style="cursor:pointer;">
                                <td>
                                    <strong>@repo.FullName</strong><br />
                                    <small class="text-muted">@repo.Description</small>
                                </td>
                                <td>@repo.Stars ⭐</td>
                                <td>@repo.Forks</td>
                                <td>@repo.PrimaryLanguage</td>
                                <td>@FormatLocalDate(repo.LastSyncedOn, "g")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => DeleteRepositoryAsync(repo.Id)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                            <!-- Releases for this repo -->
                            @if (SelectedRepoId == repo.Id)
                            {
                                <tr>
                                    <td colspan="6" class="bg-light">
                                        <button class="btn btn-sm btn-link" @onclick="() => SelectedRepoId = null">
                                            Hide Releases
                                        </button>
                                        @if (Releases.Count > 0)
                                        {
                                            <table class="table table-sm table-borderless mb-0 mt-1">
                                                <thead>
                                                    <tr>
                                                        <th>Version</th>
                                                        <th>Name</th>
                                                        <th>Published</th>
                                                        <th>Pre-release</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var release in Releases)
                                                    {
                                                        <tr>
                                                            <td><code>@release.TagName</code></td>
                                                            <td>@release.ReleaseName</td>
                                                            <td>@FormatLocalDate(release.PublishedAt, "g")</td>
                                                            <td>@(release.IsPrerelease ? "⚠️" : "")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <p class="text-muted mt-1 mb-0">No releases found.</p>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (SyncResult != null)
    {
        <div class="alert alert-@(SyncResult.Success ? "success" : "warning") alert-dismissible fade show" role="alert">
            @SyncResult.Message
            @if (SyncResult.Errors.Count > 0)
            {
                <ul class="mb-0 mt-1">
                    @foreach (var err in SyncResult.Errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
            <button type="button" class="btn-close" @onclick="() => SyncResult = null"></button>
        </div>
    }

    <!-- Webhook Events -->
    <div class="card mb-3">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-broadcast me-1"></i>Webhook Events</h6>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadWebhookEventsAsync">Refresh</button>
        </div>
        <div class="card-body p-2">
            @if (_webhookEvents.Count == 0)
            {
                <p class="text-muted mb-0 small">No webhook events received yet. Configure webhooks in your GitHub repository settings.</p>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Repository</th>
                            <th>Status</th>
                            <th>Received</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in _webhookEvents)
                        {
                            <tr>
                                <td><code>@evt.EventType</code></td>
                                <td><small>@evt.RepositoryFullName</small></td>
                                <td>
                                    @switch (evt.Status)
                                    {
                                        case "new": <span class="badge bg-primary">New</span>; break;
                                        case "processed": <span class="badge bg-success">Processed</span>; break;
                                        case "ignored": <span class="badge bg-secondary">Ignored</span>; break;
                                        case "failed": <span class="badge bg-danger">Failed</span>; break;
                                        default: <span class="badge bg-light text-dark">@evt.Status</span>; break;
                                    }
                                </td>
                                <td><small>@FormatLocalDate(evt.ReceivedOn, "g")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private GitHubSettings Settings { get; set; } = new();
    private List<GitHubRepositoryDto> Repositories { get; set; } = new();
    private List<GitHubReleaseDto> Releases { get; set; } = new();

    private string? NewRepoFullName;
    private bool ShowAddForm;
    private bool IsSyncing;
    private bool IsAdding;
    private string? StatusMessage;
    private bool StatusIsError;
    private SyncResultDto? SyncResult;
    private int? SelectedRepoId;
    private List<WebhookEventDto> _webhookEvents = new();

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await LoadRepositoriesAsync();
        await LoadWebhookEventsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            Dictionary<string, string> SiteSettings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            if (SiteSettings.TryGetValue(GitHubSettings.SettingsKey, out var jsonSettings))
            {
                Settings = JsonSerializer.Deserialize<GitHubSettings>(jsonSettings) ?? new GitHubSettings();
            }
            else
            {
                Settings = new GitHubSettings();
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to load settings: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task SaveSettingsAsync()
    {
        StatusMessage = null;
        try
        {
            var json = JsonSerializer.Serialize(Settings);
            var raw = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            raw = SettingService.SetSetting(raw, GitHubSettings.SettingsKey, json);
            await SettingService.UpdateModuleSettingsAsync(raw, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to save settings: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        try
        {
            Repositories = await RepositoryService.GetAllAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to load repositories: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task LoadWebhookEventsAsync()
    {
        try
        {
            _webhookEvents = await WebhookService.GetRecentEventsAsync(ModuleState.ModuleId, 20);
        }
        catch
        {
            _webhookEvents = new();
        }
    }

    private async Task AddRepositoryAsync()
    {
        if (string.IsNullOrWhiteSpace(NewRepoFullName))
            return;

        IsAdding = true;
        StatusMessage = null;

        try
        {
            var dto = new AddRepositoryDto { FullName = NewRepoFullName.Trim() };
            var createdBy = PageState?.User?.Username ?? "system";
            await RepositoryService.AddRepositoryAsync(dto, ModuleState.ModuleId, createdBy);
            NewRepoFullName = null;
            ShowAddForm = false;
            await LoadRepositoriesAsync();
            StatusMessage = "Repository added.";
            StatusIsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to add repository: {ex.Message}";
            StatusIsError = true;
        }
        finally
        {
            IsAdding = false;
        }
    }

    private async Task DeleteRepositoryAsync(int repositoryId)
    {
        try
        {
            await RepositoryService.DeleteAsync(repositoryId, ModuleState.ModuleId);
            await LoadRepositoriesAsync();
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to remove repository: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task SyncAllAsync()
    {
        IsSyncing = true;
        SyncResult = null;

        try
        {
            SyncResult = await SyncService.SyncAllAsync(ModuleState.ModuleId, Settings.PersonalAccessToken);
            await LoadRepositoriesAsync();
        }
        catch (Exception ex)
        {
            SyncResult = new SyncResultDto
            {
                Success = false,
                Message = $"Sync failed: {ex.Message}",
                Errors = { ex.ToString() }
            };
        }
        finally
        {
            IsSyncing = false;
        }
    }

    private async Task LoadReleasesAsync(int repositoryId)
    {
        try
        {
            SelectedRepoId = repositoryId;
            Releases = await ReleaseService.GetByRepositoryAsync(repositoryId, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            StatusMessage = $"Failed to load releases: {ex.Message}";
            StatusIsError = true;
        }
    }

    private async Task HandleAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddRepositoryAsync();
        }
    }
}
