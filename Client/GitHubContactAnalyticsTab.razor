@namespace StudioElf.Module.CRM.GitHubConnector
@using StudioElf.Module.GitHubConnector.Client
@using StudioElf.Module.GitHubConnector.Models
@using StudioElf.Module.GitHubConnector.Services
@inherits GitHubConnectorBase
@inject IGitHubRepositoryService RepositoryService
@inject IGitHubReleaseService ReleaseService

<div class="crm-tab">
    <h5>GitHub Analytics</h5>

    @if (_loading) { <p class="text-muted">Loading...</p> }
    else if (_repos.Count == 0) { <p class="text-muted">No linked repositories.</p> }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-4">
                <div class="card text-center p-2">
                    <div class="fs-4 fw-bold">@_totalReleases</div>
                    <small class="text-muted">Releases</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center p-2">
                    <div class="fs-4 fw-bold">@_openIssues</div>
                    <small class="text-muted">Open Issues</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card text-center p-2">
                    <div class="fs-4 fw-bold">@_totalStars</div>
                    <small class="text-muted">Stars</small>
                </div>
            </div>
        </div>

        @if (_chartLabels.Length > 0)
        {
            <h6>Releases (6 months)</h6>
            <div style="height:120px;">
                <canvas id="gh-release-chart" width="400" height="120"></canvas>
            </div>
        }

        <h6 class="mt-3">Repositories</h6>
        <div class="table-responsive">
            <table class="table table-sm w-100">
                <thead>
                    <tr><th>Repository</th><th>Stars</th><th>Issues</th><th>Latest Release</th></tr>
                </thead>
                <tbody>
                    @foreach (var repo in _repoStats)
                    {
                        <tr>
                            <td><strong>@repo.Name</strong></td>
                            <td>@repo.Stars ⭐</td>
                            <td>@repo.OpenIssues</td>
                            <td>@(repo.LatestRelease?.ToString("MMM dd, yyyy") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public int ContactId { get; set; }

    private List<GitHubRepositoryDto> _repos = new();
    private List<RepoSummary> _repoStats = new();
    private string[] _chartLabels = Array.Empty<string>();
    private int[] _chartData = Array.Empty<int>();
    private int _totalReleases;
    private int _openIssues;
    private int _totalStars;
    private bool _loading = true;
    private bool _rendered;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            _repos = await RepositoryService.GetByEntityAsync("contact", ContactId, ModuleState.ModuleId);
            if (_repos.Count > 0)
            {
                var releases = await ReleaseService.GetByEntityAsync("contact", ContactId, ModuleState.ModuleId);
                _totalReleases = releases.Count;
                _totalStars = _repos.Sum(r => r.Stars);
                _openIssues = _repos.Sum(r => r.OpenIssues);

                var sixMonthsAgo = DateTime.UtcNow.AddMonths(-6);
                var grouped = releases
                    .Where(r => r.PublishedAt >= sixMonthsAgo)
                    .GroupBy(r => new { r.PublishedAt.Year, r.PublishedAt.Month })
                    .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
                    .ToList();

                _chartLabels = grouped.Select(g => $"{g.Key.Year}-{g.Key.Month:D2}").ToArray();
                _chartData = grouped.Select(g => g.Count()).ToArray();

                _repoStats = _repos.Select(r => new RepoSummary
                {
                    Name = r.FullName ?? r.Name,
                    Stars = r.Stars,
                    OpenIssues = r.OpenIssues,
                    LatestRelease = releases.Where(rl => rl.RepositoryId == r.Id).MaxBy(rl => rl.PublishedAt)?.PublishedAt
                }).ToList();
            }
        }
        catch { }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_rendered && _chartLabels.Length > 0)
        {
            _rendered = true;
            await ChartInterop.DrawBarChartAsync(JSRuntime, "gh-release-chart", _chartLabels, _chartData, "Releases", "rgba(13,110,253,0.7)");
        }
    }
}
