@namespace StudioElf.Module.CRM.GitHubConnector
@using StudioElf.Module.CRM
@using StudioElf.Module.GitHubConnector.Models
@using StudioElf.Module.GitHubConnector.Services
@inherits CrmBase
@inject IGitHubRepositoryService RepositoryService

<div class="card border shadow-sm h-100">
    <div class="card-header py-2">
        <h6 class="mb-0"><i class="bi bi-github me-1"></i>GitHub Overview</h6>
    </div>
    <div class="card-body p-2">
        @if (_loading)
        {
            <small class="text-muted">Loading...</small>
        }
        else
        {
            <div class="row g-1 text-center">
                <div class="col-6">
                    <div class="fs-4 fw-bold">@_totalRepos</div>
                    <small class="text-muted">Repositories</small>
                </div>
                <div class="col-6">
                    <div class="fs-4 fw-bold">@_totalIssues</div>
                    <small class="text-muted">Open Issues</small>
                </div>
                <div class="col-6 mt-2">
                    <div class="fs-4 fw-bold">@_totalStars</div>
                    <small class="text-muted">Stars</small>
                </div>
                <div class="col-6 mt-2">
                    <div class="fs-4 fw-bold">@_totalForks</div>
                    <small class="text-muted">Forks</small>
                </div>
            </div>
            @if (_lastSync.HasValue)
            {
                <div class="mt-2 text-center">
                    <small class="text-muted">Last sync: @FormatLocalDate(_lastSync.Value, "g")</small>
                </div>
            }
        }
    </div>
</div>

@code {
    private int _totalRepos;
    private int _totalIssues;
    private int _totalStars;
    private int _totalForks;
    private DateTime? _lastSync;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            var repos = await RepositoryService.GetAllAsync(ModuleState.ModuleId);
            _totalRepos = repos.Count;
            _totalIssues = repos.Sum(r => r.OpenIssues);
            _totalStars = repos.Sum(r => r.Stars);
            _totalForks = repos.Sum(r => r.Forks);
            _lastSync = repos.Count > 0 ? repos.Max(r => r.LastSyncedOn) : null;
        }
        catch
        {
            // Widget fails silently — no data shown
        }
        _loading = false;
    }
}
