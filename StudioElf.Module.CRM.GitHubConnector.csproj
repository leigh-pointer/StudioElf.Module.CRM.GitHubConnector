<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>StudioElf.Module.CRM.GitHubConnector.Oqtane</AssemblyName>
		<RootNamespace>StudioElf.Module.GitHubConnector</RootNamespace>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../../oqtane.framework/Oqtane.Client/Oqtane.Client.csproj" />
		<ProjectReference Include="../../../oqtane.framework/Oqtane.Server/Oqtane.Server.csproj" />
		<ProjectReference Include="../../../oqtane.framework/Oqtane.Shared/Oqtane.Shared.csproj" />
		<Reference Include="StudioElf.Module.CRM.Server">
			<HintPath>D:\source\_Oqtane Instances\CRM-Oqtane\oqtane.framework\Oqtane.Server\bin\Debug\net10.0\StudioElf.Module.CRM.Server.Oqtane.dll</HintPath>
		</Reference>
		<Reference Include="StudioElf.Module.CRM.Shared">
			<HintPath>D:\source\_Oqtane Instances\CRM-Oqtane\oqtane.framework\Oqtane.Server\bin\Debug\net10.0\StudioElf.Module.CRM.Shared.Oqtane.dll</HintPath>
		</Reference>
		<Reference Include="StudioElf.Module.CRM.Client">
			<HintPath>D:\source\_Oqtane Instances\CRM-Oqtane\oqtane.framework\Oqtane.Server\bin\Debug\net10.0\StudioElf.Module.CRM.Client.Oqtane.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Target Name="PostBuildPackage" AfterTargets="Build">
		<Exec Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Debug'" Command="&quot;$(MSBuildProjectDirectory)\Package\debug.cmd&quot; PostBuild" />
		<Exec Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Release'" Command="&quot;$(MSBuildProjectDirectory)\Package\release.cmd&quot; $(TargetFramework) PostBuild" />
	</Target>
</Project>